# URL de base de l'API backend NestJS (préfixe /api inclus)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL du serveur WebSocket (messagerie temps réel)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Secret NextAuth — OBLIGATOIRE en production
# Générer avec : openssl rand -base64 32
# Ce secret chiffre les cookies de session. Ne jamais le committer.
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# URL de base du frontend (utilisé par NextAuth pour les redirections)
NEXTAUTH_URL=http://localhost:3000
