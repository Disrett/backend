# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://user:password@localhost:5432/sans_limite?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET="change-moi-access-secret-long-et-aleatoire"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-moi-refresh-secret-different-et-aleatoire"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Serveur ---
PORT=3001
# Origine autorisée pour le CORS (votre front Next.js)
FRONTEND_URL="http://localhost:3000"

# --- Stockage objet (images posts / avatars) — à brancher plus tard ---
